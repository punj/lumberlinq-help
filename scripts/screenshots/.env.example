# Copy to .env and adjust. Never commit the real .env or auth-state.json.

BASE_URL=https://app.lumberlinq.com

# Where login-and-save-state.mjs writes, and capture.mjs reads, the saved session.
AUTH_STATE=./auth-state.json

# Where capture.mjs writes screenshots — flat, self-describing filenames
# ({category}__{region}__{seq}.png), same as the original tool. Sort/copy into
# public/screenshots/<category>/ afterward, matching how the last real capture batch
# (68 files, Aug 7 2026) was integrated — review before trusting any of them as final,
# that same batch had 2 genuinely mislabeled shots caught only by a human look.
OUTPUT_DIR=./screenshots

# true (default): only run manifest entries marked verified:true.
# false: also attempt the verified:false entries — expect some of these to fail or need a
#        selector fix, since they're honestly marked as not yet confirmed against the live app.
ONLY_VERIFIED=true

# Only needed for the AUTOMATED login path (Turnstile disabled), only read by
# login-and-save-state.mjs. Set in your real .env, never here, never in chat.
# LUMBERLINQ_EMAIL=demo@yourcompany.com
# LUMBERLINQ_PASSWORD=your-password-here

# The 3 affiliate-portal entries (verification/payout-account/dashboard) need a DIFFERENT
# account than your main login — one already approved as an affiliate (ROLE_AFFILIATE).
# capture.mjs only reads ONE auth state per run, so do these as a separate second pass:
#   LUMBERLINQ_EMAIL=affiliate@... LUMBERLINQ_PASSWORD=... AUTH_STATE=./affiliate-auth-state.json \
#     node login-and-save-state.mjs
#   AUTH_STATE=./affiliate-auth-state.json ONLY_VERIFIED=false \
#     ONLY_NAMES=affiliate-program__verification-page__01,affiliate-program__payout-account-form__01,affiliate-program__dashboard__01 \
#     node capture.mjs
